// ax65.proj — disasm プロジェクトの設定（仕様書 1.1 17.2節）
project disasm {
    main       = "src/disasm.ax65";     // プログラムの入口（main を含むファイル）
    paths      = ["."];                 // use でモジュールを探す場所（hw::acia_console → ./hw/acia_console.ax65）
    target_dir = "targets";             // ターゲット定義を探す場所
    targets    = [v2];                  // ax65 check --all-targets の対象
    default    = v2;                    // -t を省略したときのターゲット
    opt        = O2;                    // -O を省略したときの最適化の段階（既定も O2）
    out_dir    = "build";               // 出力先（build/<ターゲット名>/ の下に出力する）

    lints {                             // 警告の扱い（allow / warn / deny）
        naming         = warn;
        unused_imports = warn;
    }
    fmt {                               // ax65 fmt の書き方
        hex   = dollar;                 // 16進は $FF に統一する
        array = rust;                   // 配列の型は [T; N] に統一する
    }
}
