// ax65.proj — ch07_functions のプロジェクトファイル
project functions {
    main       = "src/functions.ax65";  // main を含むファイル
    paths      = [".", "iface"];        // use でモジュールを探す場所（"iface" は自分で作ったインターフェースの置き場所）
    target_dir = "targets";             // ターゲット定義を探す場所
    targets    = [v2, v3];              // ax65 check --all-targets の対象
    default    = v2;                    // -t を省略したときのターゲット
    opt        = O2;                    // -O を省略したときの最適化の段階
    out_dir    = "build";               // 出力先（build/<ターゲット名>/）

    lints {                             // 警告の扱い（allow / warn / deny）
        naming         = warn;
        unused_imports = warn;
    }
    fmt {                               // ax65 fmt の書き方
        hex   = dollar;                 // 16 進は $FF
        array = rust;                   // 配列の型は [T; N]
    }
}
