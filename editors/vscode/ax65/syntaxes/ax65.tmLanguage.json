{
  "name": "AX65",
  "scopeName": "source.ax65",
  "fileTypes": [
    "ax65",
    "target"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#asm"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#label"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#encoding-tag"
        },
        {
          "include": "#function-decl"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#paths"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ax65",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ax65",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attribute": {
      "name": "meta.attribute.ax65",
      "begin": "#\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.ax65"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.attribute.ax65"
        }
      },
      "patterns": [
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "name": "entity.other.attribute-name.ax65",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ax65",
      "begin": "(?:\\b(p|z|hi))?\"",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.string-prefix.ax65"
        }
      },
      "end": "\"(@[A-Za-z_][A-Za-z0-9_]*)?",
      "endCaptures": {
        "1": {
          "name": "entity.name.tag.encoding.ax65"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.ax65",
          "match": "\\\\(x[0-9A-Fa-f]{2}|[nrt0\\\\'\"])"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.ax65",
      "match": "'(\\\\(x[0-9A-Fa-f]{2}|[nrt0\\\\'\"])|[^'\\\\])'(@[A-Za-z_][A-Za-z0-9_]*)?",
      "captures": {
        "2": {
          "name": "constant.character.escape.ax65"
        },
        "3": {
          "name": "entity.name.tag.encoding.ax65"
        }
      }
    },
    "label": {
      "name": "entity.name.label.ax65",
      "match": "'[A-Za-z_][A-Za-z0-9_]*\\b(?!')"
    },
    "encoding-tag": {
      "name": "entity.name.tag.encoding.ax65",
      "match": "(?<=[A-Za-z0-9_])@[A-Za-z_][A-Za-z0-9_]*"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ax65",
          "match": "\\$[0-9A-Fa-f_]+\\b|\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.ax65",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.ax65",
          "match": "\\b[0-9][0-9_]*(\\.[0-9]+)?\\b"
        }
      ]
    },
    "function-decl": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.ax65"
        },
        "2": {
          "name": "entity.name.function.ax65"
        }
      }
    },
    "function-call": {
      "name": "entity.name.function.call.ax65",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ax65",
          "match": "\\b(if|else|match|loop|while|for|in|break|continue|return)\\b"
        },
        {
          "name": "keyword.other.ax65",
          "match": "\\b(as|const|enum|extern|fn|impl|let|pub|static|struct|type|unsafe|use|range|flags|fnset|interface|io|shared|init|comptime|asm|atomic|cycles|io_span|max_cycles)\\b"
        },
        {
          "name": "keyword.other.target.ax65",
          "match": "\\b(target|extends|region|reserve|place|encoding|bind|project|never|halt)\\b"
        },
        {
          "name": "invalid.illegal.reserved.ax65",
          "match": "\\b(mut)\\b"
        },
        {
          "name": "constant.language.ax65",
          "match": "\\b(true|false|Some|None)\\b"
        },
        {
          "name": "support.function.builtin.ax65",
          "match": "\\b(irq_enable|irq_disable|wait_interrupt|delay|size_of|include_bin|build|Cpu|sin|cos|sqrt|round|floor|abs|PI|core)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.ax65",
          "match": "\\b(u8|i8|u16|i16|u24|i24|u32|i32|bool|char|str|zstr|histr|bcd8|bcd16|bcd32|ptr|strbuf|int|real|Option)\\b"
        },
        {
          "name": "entity.name.type.ax65",
          "match": "\\b[A-Z][a-z0-9]+[A-Za-z0-9]*\\b"
        }
      ]
    },
    "paths": {
      "name": "constant.other.const.ax65",
      "match": "\\b[A-Z][A-Z0-9_]+\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.ax65",
          "match": "\\.\\.=?"
        },
        {
          "name": "punctuation.separator.namespace.ax65",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.ax65",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.ax65",
          "match": "<<=?|>>=?|&&|\\|\\||[-+*/%&|^!<>=~]=?"
        }
      ]
    },
    "asm": {
      "comment": "asm { … }、asm (…) { … }、asm fn …(…) { … }、unsafe asm (…) { … }。{ までの見出しは通常のコード、{ から } までは 65C02 のアセンブリとして色付けする。{名前} の参照は #asm-body で先に取り込むので、ブロックの終わりの } と混ざらない",
      "begin": "\\b(?:(unsafe)\\s+)?(asm)\\b(?=[^{};]*\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.ax65"
        },
        "2": {
          "name": "keyword.other.asm.ax65"
        }
      },
      "end": "(?<=\\})",
      "patterns": [
        {
          "name": "meta.embedded.block.asm6502.ax65",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.block.begin.ax65"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.ax65"
            }
          },
          "patterns": [
            {
              "include": "#asm-body"
            }
          ]
        },
        {
          "include": "#comments"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#function-decl"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#paths"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "asm-body": {
      "patterns": [
        {
          "name": "comment.line.semicolon.asm6502",
          "match": ";.*$"
        },
        {
          "include": "#comments"
        },
        {
          "name": "variable.other.ax65-ref.asm6502",
          "match": "\\{[^{}\\n]*\\}"
        },
        {
          "match": "^\\s*(?:(smc)\\s+)?([@A-Za-z_][A-Za-z0-9_]*)(:)",
          "captures": {
            "1": {
              "name": "keyword.other.smc.asm6502"
            },
            "2": {
              "name": "entity.name.label.asm6502"
            },
            "3": {
              "name": "punctuation.separator.label.asm6502"
            }
          }
        },
        {
          "name": "keyword.other.smc.asm6502",
          "match": "\\bsmc\\b"
        },
        {
          "name": "keyword.mnemonic.asm6502",
          "match": "(?i)\\b(adc|and|asl|bbr[0-7]|bbs[0-7]|bcc|bcs|beq|bit|bmi|bne|bpl|bra|brk|bvc|bvs|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|jmp|jsr|lda|ldx|ldy|lsr|nop|ora|pha|php|phx|phy|pla|plp|plx|ply|rmb[0-7]|rol|ror|rti|rts|sbc|sec|sed|sei|smb[0-7]|sta|stp|stx|sty|stz|tax|tay|trb|tsb|tsx|txa|txs|tya|wai)\\b"
        },
        {
          "name": "variable.language.register.asm6502",
          "match": "(?i)\\b[axy]\\b"
        },
        {
          "include": "#chars"
        },
        {
          "name": "constant.numeric.asm6502",
          "match": "#?\\$[0-9A-Fa-f_]+|#?\\b0x[0-9A-Fa-f_]+\\b|#?\\b0b[01_]+\\b|#?\\b[0-9][0-9_]*\\b"
        },
        {
          "name": "keyword.operator.immediate.asm6502",
          "match": "#"
        }
      ]
    }
  }
}
